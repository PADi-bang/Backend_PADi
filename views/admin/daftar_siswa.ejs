<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daftar Siswa - App_PADi</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="icon" type="image/png" href="/favicon.png">


    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#006D5B',
                        'primary-dark': '#004A3F',
                        'primary-light': '#338A7B',
                    },
                    fontFamily: {
                        sans: ['Outfit', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <!-- TensorFlow.js, BlazeFace, and TFJS TFLite dependencies for mobilefacenet -->
    <script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs"></script>
    <script src="https://cdn.jsdelivr.net/npm/@tensorflow-models/blazeface"></script>
    <script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs-tflite/dist/tf-tflite.min.js"></script>

</head>

<body class="bg-slate-100 flex font-sans">

    <!-- Mobile Header -->
    <div class="md:hidden bg-[#00382E] text-white p-4 flex justify-between items-center fixed top-0 w-full z-30 shadow-md">
        <div class="flex items-center gap-2">
            <img src="/images/logo_padi.png" alt="Logo" class="w-8 h-8 object-contain drop-shadow-md">
            <span class="text-xl font-black tracking-widest">PADi</span>
        </div>
        <button onclick="document.getElementById('sidebar').classList.remove('-translate-x-full')" class="p-2 bg-white/10 rounded-lg focus:outline-none">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
        </button>
    </div>

    <aside id="sidebar" class="w-64 h-screen bg-[#00382E] text-white/70 p-6 flex flex-col fixed rounded-r-3xl shadow-2xl z-40 transform -translate-x-full md:translate-x-0 transition-transform duration-300">
        <div class="flex items-center gap-3 mb-12 mt-4 pl-2">
            <img src="/images/logo_padi.png" alt="Logo" class="w-10 h-10 object-contain drop-shadow-md">
            <span class="text-3xl font-black text-white tracking-widest">PADi</span>
        </div>
        <button onclick="document.getElementById('sidebar').classList.add('-translate-x-full')" class="md:hidden absolute top-6 right-4 p-2 text-white/70 hover:text-white">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
        <nav class="flex-1 space-y-3">
            <a href="/dashboard"
                class="flex items-center gap-4 p-3.5 hover:text-white hover:bg-white/10 rounded-2xl transition">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z">
                    </path>
                </svg> Dashboard
            </a>
            <a href="/daftar-siswa"
                class="flex items-center gap-4 p-3.5 bg-primary text-white rounded-2xl shadow-lg shadow-primary/40 transition">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z">
                    </path>
                </svg> Daftar Siswa
            </a>
            <a href="/daftar-guru"
                class="flex items-center gap-4 p-3.5 hover:text-white hover:bg-white/10 rounded-2xl transition">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z">
                    </path>
                </svg> Daftar Guru
            </a>
            <a href="/jadwal"
                class="flex items-center gap-4 p-3.5 hover:text-white hover:bg-white/10 rounded-2xl transition">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z">
                    </path>
                </svg> Jadwal
            </a>
            <a href="/master-data"
                class="flex items-center gap-4 p-3.5 hover:text-white hover:bg-white/10 rounded-2xl transition">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"></path>
                </svg> Master Data
            </a>
            <a href="/enrolment"
                class="flex items-center gap-4 p-3.5 hover:text-white hover:bg-white/10 rounded-2xl transition">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z">
                    </path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z">
                    </path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222">
                    </path>
                </svg> Enrolment Kelas
            </a>
            <a href="/lokasi-sekolah" class="flex items-center gap-4 p-3.5 hover:text-white hover:bg-white/10 rounded-2xl transition">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg> Lokasi Sekolah
            </a>
        </nav>
        <div class="mt-auto mb-4">
            <a href="/logout"
                class="flex justify-center items-center gap-2 bg-primary hover:bg-primary-dark text-white font-bold py-3.5 px-4 rounded-full transition shadow-lg shadow-primary/30">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1">
                    </path>
                </svg> LOGOUT
            </a>
        </div>
    </aside>

    <main class="flex-1 md:ml-64 p-4 md:p-8 pt-24 md:pt-8 w-full transition-all duration-300">

        <div
            class="bg-primary rounded-3xl p-4 flex justify-between items-center text-white mb-8 shadow-lg shadow-primary/20">
            <form action="/daftar-siswa" method="GET" class="relative w-96 ml-2">
                <span class="absolute left-4 top-2.5 opacity-50">🔍</span>
                <input type="text" name="search" value="<%= typeof search !== 'undefined' ? search : '' %>"
                    placeholder="Cari siswa, NIS, atau email..."
                    class="w-full bg-primary-dark/50 text-white placeholder-blue-200 border border-primary-light/50 rounded-full pl-12 pr-4 py-2 outline-none focus:ring-2 focus:ring-white/50 text-sm transition">
            </form>

            <div class="flex items-center gap-4 pr-4">
                <button onclick="toggleModal('modalImportSiswa')"
                    class="bg-white/10 hover:bg-white/20 border border-white/20 text-white px-5 py-2 rounded-full text-xs font-bold shadow-md transition">📥
                    Import CSV/Excel</button>
                <button onclick="toggleModal('modalTambahSiswa')"
                    class="bg-white text-primary px-5 py-2 rounded-full text-xs font-bold shadow-md hover:bg-gray-100 transition">+
                    Tambah Siswa</button>
                <div class="flex items-center gap-3 border-l border-primary-light/50 pl-6 cursor-pointer">
                    <span class="text-sm font-bold tracking-wide uppercase">Admin PADI</span>
                    <div
                        class="w-9 h-9 bg-white rounded-full flex items-center justify-center text-primary font-bold text-xs">
                        AD</div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
            <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100 flex justify-between items-center">
                <div>
                    <p class="text-gray-400 text-xs font-bold uppercase">Total Siswa</p>
                    <h3 class="text-3xl font-bold text-gray-800 mt-1">
                        <%= siswas ? siswas.length : 0 %>
                    </h3>
                </div>
                <div class="bg-slate-100 border p-4 rounded-full text-2xl">👥</div>
            </div>
            <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100 flex justify-between items-center">
                <div>
                    <p class="text-gray-400 text-xs font-bold uppercase">Siswa Aktif</p>
                    <h3 class="text-3xl font-bold text-gray-800 mt-1">
                        <%= siswas ? siswas.length : 0 %>
                    </h3>
                </div>
                <div class="bg-green-50 border border-green-100 p-4 rounded-full text-2xl text-green-500">✅</div>
            </div>
            <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100 flex justify-between items-center">
                <div>
                    <p class="text-gray-400 text-xs font-bold uppercase">Dalam Izin</p>
                    <h3 class="text-3xl font-bold text-gray-800 mt-1">0</h3>
                </div>
                <div class="bg-orange-50 border border-orange-100 p-4 rounded-full text-2xl text-orange-500">🌙</div>
            </div>
        </div>

        <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-x-auto"><table class="w-full text-left">
                <thead class="bg-slate-50 text-[10px] text-gray-400 uppercase tracking-wider font-bold">
                    <tr>
                        <th class="px-8 py-4">Siswa</th>
                        <th class="px-6 py-4">NIS</th>
                        <th class="px-6 py-4">Angkatan</th>
                        <th class="px-6 py-4">Kelas</th>
                        <th class="px-6 py-4">Status</th>
                        <th class="px-6 py-4 text-center">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y text-sm">
                    <% if (typeof siswas !=='undefined' && siswas.length> 0) { %>
                        <% siswas.forEach(function(user) { %>
                            <tr class="hover:bg-slate-50 transition">
                                <td class="px-8 py-4 flex items-center gap-4">
                                    <div
                                        class="w-10 h-10 bg-primary/20 text-primary font-bold rounded-full flex items-center justify-center">
                                        <%= user.siswa && user.siswa.namaLengkap ? user.siswa.namaLengkap.substring(0,
                                            2).toUpperCase() : 'U' %>
                                    </div>
                                    <div>
                                        <p class="font-bold text-gray-800">
                                            <%= user.siswa ? user.siswa.namaLengkap : 'Tanpa Nama' %>
                                        </p>
                                        <p class="text-xs text-gray-400">
                                            <%= user.email %>
                                        </p>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-gray-500 font-mono text-xs">
                                    <%= user.siswa ? user.siswa.nis : '-' %>
                                </td>
                                <td class="px-6 py-4 font-bold text-gray-700">
                                    <%= user.siswa && user.siswa.masterAngkatan ?
                                        user.siswa.masterAngkatan.nomorAngkatan : '-' %>
                                </td>
                                <td class="px-6 py-4">
                                    <% let namaKelas='-' ; if (user.siswa && user.siswa.enrolmentSiswa &&
                                        user.siswa.enrolmentSiswa.length> 0) {
                                        const activeEnrol = user.siswa.enrolmentSiswa.find(e => e.isActive);
                                        if (activeEnrol && activeEnrol.enrolmentKelas &&
                                        activeEnrol.enrolmentKelas.masterKelas) {
                                        const mk = activeEnrol.enrolmentKelas.masterKelas;
                                        namaKelas = mk.tingkat ? `${mk.tingkat.namaTingkat} ${mk.namaKelas}` :
                                        mk.namaKelas;
                                        }
                                        }
                                        %>
                                        <span
                                            class="bg-slate-100 border text-gray-600 px-3 py-1.5 rounded-lg text-[10px] font-bold">
                                            <%= namaKelas %>
                                        </span>
                                </td>
                                <td class="px-6 py-4"><span
                                        class="text-green-500 font-bold text-xs flex items-center gap-1">🔴 Aktif</span>
                                </td>
                                <td class="px-6 py-4 flex justify-center gap-2 items-center">
                                    <% const hasFace=user.siswa && user.siswa.faceModel && user.siswa.faceModel.trim()
                                        !=='' ; %>
                                        <button onclick="bukaUploadWajah(this)" data-id="<%= user.id %>"
                                            data-nama="<%= user.siswa ? user.siswa.namaLengkap : '' %>"
                                            class="<%= hasFace ? 'bg-green-100 text-green-600 hover:bg-green-200' : 'bg-red-100 text-red-600 hover:bg-red-200' %> px-3 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1"
                                            title="<%= hasFace ? 'Sudah Diunggah - Klik untuk mengganti wajah' : 'Belum Diunggah - Klik untuk mendaftarkan wajah' %>">
                                            📷 <span class="hidden md:inline">
                                                <%= hasFace ? 'Terdaftar (Edit)' : 'Daftar Wajah' %>
                                            </span>
                                        </button>

                                        <button onclick="bukaEditSiswa(this)" data-id="<%= user.id %>"
                                            data-nama="<%= user.siswa ? user.siswa.namaLengkap : '' %>"
                                            data-nis="<%= user.siswa ? user.siswa.nis : '' %>"
                                            data-username="<%= user.username %>" data-email="<%= user.email %>"
                                            data-angkatan-id="<%= user.siswa ? user.siswa.angkatanId : '' %>"
                                            class="bg-primary/20 text-primary px-3 py-1.5 rounded-lg text-xs font-bold hover:bg-primary/30 transition">Edit</button>

                                        <form action="/daftar-siswa/delete/<%= user.id %>" method="POST" class="inline"
                                            onsubmit="return confirmDelete(event, this);">
                                            <button type="submit"
                                                class="bg-red-100 text-red-600 px-3 py-1.5 rounded-lg text-xs font-bold hover:bg-red-200 transition">Hapus</button>
                                        </form>
                                </td>
                            </tr>
                            <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="5" class="px-8 py-8 text-center text-gray-500 font-bold">Tidak ada
                                            data siswa.</td>
                                    </tr>
                                    <% } %>
                </tbody>
            </table>
        </div>
    </main>

    <div id="modalTambahSiswa"
        class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden flex justify-center items-center">
        <div class="bg-white rounded-3xl p-8 w-full max-w-md shadow-2xl relative">
            <button onclick="toggleModal('modalTambahSiswa')"
                class="absolute top-6 right-6 text-gray-400 hover:text-black font-bold">✖</button>
            <h2 class="text-2xl font-bold text-gray-800 mb-6">Tambah Siswa</h2>
            <form action="/daftar-siswa" method="POST" class="space-y-4">
                <input type="text" name="namaLengkap" placeholder="Nama Lengkap" required
                    class="w-full bg-slate-50 border rounded-xl px-4 py-3 text-sm outline-none focus:border-primary-light">
                <div class="grid grid-cols-2 gap-4">
                    <input type="text" name="nis" placeholder="NIS" required
                        class="w-full bg-slate-50 border rounded-xl px-4 py-3 text-sm outline-none focus:border-primary-light">
                    <input type="text" name="username" placeholder="Username" required
                        class="w-full bg-slate-50 border rounded-xl px-4 py-3 text-sm outline-none focus:border-primary-light">
                </div>
                <input type="email" name="email" placeholder="Email" required
                    class="w-full bg-slate-50 border rounded-xl px-4 py-3 text-sm outline-none focus:border-primary-light">
                <input type="password" name="password" placeholder="Password" required
                    class="w-full bg-slate-50 border rounded-xl px-4 py-3 text-sm outline-none focus:border-primary-light">
                <select name="angkatanId" required
                    class="w-full bg-slate-50 border rounded-xl px-4 py-3 text-sm outline-none focus:border-primary-light">
                    <option value="">-- Pilih Angkatan --</option>
                    <% if (typeof masterAngkatan !=='undefined' ) { %>
                        <% masterAngkatan.forEach(a=> { %>
                            <option value="<%= a.id %>">
                                <%= a.nomorAngkatan %>
                            </option>
                            <% }) %>
                                <% } %>
                </select>
                <input type="hidden" name="sekolahId" value="1">
                <button type="submit"
                    class="w-full bg-primary text-white font-bold rounded-xl py-3.5 mt-4 hover:bg-primary-dark">Simpan
                    Data</button>
            </form>
        </div>
    </div>

    <div id="modalEditSiswa"
        class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden flex justify-center items-center">
        <div class="bg-white rounded-3xl p-8 w-full max-w-md shadow-2xl relative">
            <button onclick="toggleModal('modalEditSiswa')"
                class="absolute top-6 right-6 text-gray-400 hover:text-black font-bold">✖</button>
            <h2 class="text-2xl font-bold text-gray-800 mb-6">Edit Siswa</h2>
            <form id="formEditSiswa" method="POST" class="space-y-4">
                <input type="text" id="editNama" name="namaLengkap" required
                    class="w-full bg-slate-50 border rounded-xl px-4 py-3 text-sm outline-none focus:border-primary-light">
                <div class="grid grid-cols-2 gap-4">
                    <input type="text" id="editNis" name="nis" required
                        class="w-full bg-slate-50 border rounded-xl px-4 py-3 text-sm outline-none focus:border-primary-light">
                    <input type="text" id="editUsername" name="username" required
                        class="w-full bg-slate-50 border rounded-xl px-4 py-3 text-sm outline-none focus:border-primary-light">
                </div>
                <input type="email" id="editEmail" name="email" required
                    class="w-full bg-slate-50 border rounded-xl px-4 py-3 text-sm outline-none focus:border-primary-light">
                <input type="password" name="password" placeholder="Kosongkan jika tidak ingin ganti sandi"
                    class="w-full bg-slate-50 border rounded-xl px-4 py-3 text-sm outline-none focus:border-primary-light">
                <select name="angkatanId" id="editAngkatanId" required
                    class="w-full bg-slate-50 border rounded-xl px-4 py-3 text-sm outline-none focus:border-primary-light">
                    <option value="">-- Pilih Angkatan --</option>
                    <% if (typeof masterAngkatan !=='undefined' ) { %>
                        <% masterAngkatan.forEach(a=> { %>
                            <option value="<%= a.id %>">
                                <%= a.nomorAngkatan %>
                            </option>
                            <% }) %>
                                <% } %>
                </select>
                <button type="submit"
                    class="w-full bg-primary text-white font-bold rounded-xl py-3.5 mt-4 hover:bg-primary-dark">Update
                    Data</button>
            </form>
        </div>
    </div>

    <!-- MODAL IMPORT SISWA -->
    <div id="modalImportSiswa"
        class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden flex justify-center items-center">
        <div class="bg-white rounded-3xl p-8 w-full max-w-md shadow-2xl relative">
            <button onclick="toggleModal('modalImportSiswa')"
                class="absolute top-6 right-6 text-gray-400 hover:text-black font-bold">✖</button>
            <h2 class="text-2xl font-bold text-gray-800 mb-2">Import Masal Siswa</h2>
            <p class="text-xs text-gray-500 mb-4">Unggah file Excel (.xlsx, .xls) atau CSV dengan urutan/header
                kolom:<br><strong
                    class="text-primary font-mono bg-slate-50 px-1.5 py-1 rounded block mt-2 text-center text-[11px]">nama,
                    nis, angkatan, kelas, email, password</strong></p>

            <div class="mb-6 text-center">
                <a href="/template_import_siswa.csv" download
                    class="inline-flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-gray-700 hover:text-gray-900 px-4 py-2 rounded-xl text-xs font-bold transition">
                    📥 Download Template CSV Contoh
                </a>
            </div>

            <form action="/daftar-siswa/upload" method="POST" enctype="multipart/form-data" class="space-y-6">
                <div
                    class="border-2 border-dashed border-gray-200 hover:border-primary rounded-2xl p-6 text-center cursor-pointer transition relative">
                    <input type="file" name="file" accept=".xlsx, .xls, .csv" required
                        class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" onchange="updateFileName(this)">
                    <div id="uploadPlaceholder" class="space-y-2">
                        <div class="text-4xl text-gray-300">📊</div>
                        <p class="text-sm font-semibold text-gray-600">Pilih file untuk diunggah</p>
                        <p class="text-xs text-gray-400">Mendukung format .xlsx, .xls, .csv</p>
                    </div>
                    <div id="uploadFileInfo" class="hidden space-y-2">
                        <div class="text-4xl text-primary">📄</div>
                        <p id="uploadFileName" class="text-sm font-bold text-gray-800 truncate px-4"></p>
                        <p class="text-xs text-primary-light hover:underline">Ganti file</p>
                    </div>
                </div>

                <button type="submit"
                    class="w-full bg-primary text-white font-bold rounded-xl py-3.5 hover:bg-primary-dark shadow-lg shadow-primary/30 transition">Mulai
                    Impor</button>
            </form>
        </div>
    </div>

    <!-- MODAL REGISTRASI WAJAH -->
    <div id="modalUploadWajah"
        class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden flex justify-center items-center">
        <div class="bg-white rounded-3xl p-8 w-full max-w-3xl shadow-2xl relative">
            <button onclick="toggleModal('modalUploadWajah')"
                class="absolute top-6 right-6 text-gray-400 hover:text-black font-bold">✖</button>
            <h2 class="text-2xl font-bold text-gray-800 mb-2">Registrasi Biometrik Wajah</h2>
            <p class="text-xs text-gray-500 mb-6">Daftarkan wajah untuk siswa: <span id="wajahSiswaNama"
                    class="font-bold text-gray-700"></span></p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- Sisi Kiri: Drag & Drop Upload & Preview -->
                <div class="flex flex-col justify-between">
                    <input type="hidden" id="wajahSiswaUserId">
                    <div id="uploadWajahArea"
                        class="border-2 border-dashed border-gray-200 hover:border-primary rounded-2xl p-8 text-center cursor-pointer transition relative flex flex-col items-center justify-center min-h-[250px] bg-slate-50"
                        ondragover="handleDragOver(event)" ondragleave="handleDragLeave(event)"
                        ondrop="handleDrop(event)">

                        <input type="file" id="inputFotoWajah" accept="image/*"
                            class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"
                            onchange="previewWajah(this)">

                        <div id="wajahPlaceholder" class="space-y-3">
                            <div class="text-5xl text-gray-300">📷</div>
                            <p class="text-sm font-bold text-gray-600">Seret & lepas foto di sini</p>
                            <p class="text-xs text-gray-400">atau klik untuk menelusuri file</p>
                            <p class="text-[10px] text-gray-400">Mendukung format JPG, JPEG, PNG</p>
                        </div>

                        <div id="wajahFileInfo" class="hidden space-y-2 flex flex-col items-center justify-center">
                            <img id="wajahPreview"
                                class="w-40 h-40 object-cover rounded-2xl border-2 border-primary/20 shadow-md">
                            <p class="text-xs text-primary-light hover:underline mt-2">Ganti foto</p>
                        </div>
                    </div>
                </div>

                <!-- Sisi Kanan: Panduan (SOP), Status & Action Button -->
                <div class="flex flex-col justify-between space-y-4">
                    <!-- SOP Papan Panduan -->
                    <div class="bg-primary/10 border border-primary/20 rounded-2xl p-4 text-xs space-y-2 text-primary-dark">
                        <p class="font-bold text-blue-800 mb-1">💡 Panduan Pengambilan Foto (SOP):</p>
                        <div class="flex items-start gap-2">
                            <span>➡️</span>
                            <span>Wajah harus menghadap lurus ke depan dengan pandangan mata fokus.</span>
                        </div>
                        <div class="flex items-start gap-2">
                            <span>➡️</span>
                            <span>Pencahayaan terang dan merata (hindari bayangan).</span>
                        </div>
                        <div class="flex items-start gap-2">
                            <span>➡️</span>
                            <span>Hindari aksesoris yang menutupi wajah (masker, kacamata hitam, topi).</span>
                        </div>
                    </div>

                    <!-- Status & Progress -->
                    <div id="wajahStatusContainer" class="hidden p-3.5 rounded-xl border text-xs font-semibold">
                        <p id="wajahStatusText" class="text-center"></p>
                    </div>

                    <!-- Simpan Wajah Button -->
                    <button type="button" id="btnSimpanWajah" onclick="prosesEkstraksiWajah()" disabled
                        class="w-full bg-primary text-white font-bold rounded-xl py-4 hover:bg-primary-dark shadow-lg shadow-primary/30 transition disabled:opacity-50 disabled:cursor-not-allowed">Simpan
                        Wajah</button>
                </div>
            </div>
        </div>
    </div>

    <script type="application/json" id="import-errors-data">
        <%- typeof importErrors !== 'undefined' && importErrors ? JSON.stringify(importErrors) : 'null' %>
    </script>

    <script>
        function toggleModal(modalID) {
            const modal = document.getElementById(modalID);
            modal.classList.toggle('hidden');
        }

        function updateFileName(input) {
            const placeholder = document.getElementById('uploadPlaceholder');
            const fileInfo = document.getElementById('uploadFileInfo');
            const fileName = document.getElementById('uploadFileName');

            if (input.files && input.files.length > 0) {
                placeholder.classList.add('hidden');
                fileInfo.classList.remove('hidden');
                fileName.textContent = input.files[0].name;
            } else {
                placeholder.classList.remove('hidden');
                fileInfo.classList.add('hidden');
                fileName.textContent = '';
            }
        }

        function bukaEditSiswa(button) {
            const id = button.getAttribute('data-id');
            const nama = button.getAttribute('data-nama');
            const nis = button.getAttribute('data-nis');
            const username = button.getAttribute('data-username');
            const email = button.getAttribute('data-email');
            const angkatanId = button.getAttribute('data-angkatan-id');

            document.getElementById('formEditSiswa').action = '/daftar-siswa/edit/' + id;
            document.getElementById('editNama').value = nama;
            document.getElementById('editNis').value = nis;
            document.getElementById('editUsername').value = username;
            document.getElementById('editEmail').value = email;
            document.getElementById('editAngkatanId').value = angkatanId || '';
            toggleModal('modalEditSiswa');
        }

        function confirmDelete(e, form) {
            e.preventDefault();
            Swal.fire({
                title: 'Hapus Siswa?', text: "Semua riwayat absen siswa ini akan ikut terhapus permanen!", icon: 'warning',
                showCancelButton: true, confirmButtonColor: '#ef4444', cancelButtonColor: '#64748b', confirmButtonText: 'Ya, Hapus!'
            }).then((result) => {
                if (result.isConfirmed) form.submit();
            });
        }

        // Handle Query Parameters and Session Import Errors on Page Load
        window.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const successMsg = urlParams.get('success');
            const errorMsg = urlParams.get('error');
            const hasWarning = urlParams.get('warning');

            // EJS injects importErrors here
            const importErrors = JSON.parse(document.getElementById('import-errors-data').textContent);

            if (successMsg) {
                if (hasWarning && importErrors && importErrors.length > 0) {
                    let errorListHtml = '<div class="text-left max-h-40 overflow-y-auto text-xs space-y-1 bg-slate-50 p-3 rounded-lg border border-yellow-200 mt-2">';
                    importErrors.forEach(err => {
                        if (typeof err === 'string') {
                            errorListHtml += `<p class="text-yellow-700 font-semibold">• ${err}</p>`;
                        } else {
                            errorListHtml += `<p class="text-yellow-700 font-semibold">• Baris ${err.row}: ${err.reason} (${err.details || ''})</p>`;
                        }
                    });
                    errorListHtml += '</div>';

                    Swal.fire({
                        title: 'Impor Selesai dengan Peringatan',
                        html: `<p class="text-sm text-gray-600 mb-2">${successMsg}</p><p class="text-xs font-bold text-gray-500 mb-1">Daftar baris yang dilewati / bermasalah:</p>${errorListHtml}`,
                        icon: 'warning',
                        confirmButtonText: 'OK',
                        confirmButtonColor: '#006D5B'
                    }).then(() => {
                        window.history.replaceState({}, document.title, window.location.pathname);
                    });
                } else {
                    Swal.fire({
                        title: 'Berhasil!',
                        text: successMsg,
                        icon: 'success',
                        confirmButtonText: 'OK',
                        confirmButtonColor: '#006D5B'
                    }).then(() => {
                        window.history.replaceState({}, document.title, window.location.pathname);
                    });
                }
            } else if (errorMsg) {
                Swal.fire({
                    title: 'Gagal!',
                    text: errorMsg.replace(/_/g, ' '),
                    icon: 'error',
                    confirmButtonText: 'Tutup',
                    confirmButtonColor: '#ef4444'
                }).then(() => {
                    window.history.replaceState({}, document.title, window.location.pathname);
                });
            }
        });
        let blazefaceModel = null;
        let tfliteModel = null;

        // Set WASM path for tflite immediately when this script block runs
        if (typeof tflite !== 'undefined') {
            tflite.setWasmPath('https://cdn.jsdelivr.net/npm/@tensorflow/tfjs-tflite/dist/');
        }

        function handleDragOver(e) {
            e.preventDefault();
            document.getElementById('uploadWajahArea').classList.add('border-primary', 'bg-primary/5');
        }

        function handleDragLeave(e) {
            e.preventDefault();
            document.getElementById('uploadWajahArea').classList.remove('border-primary', 'bg-primary/5');
        }

        function handleDrop(e) {
            e.preventDefault();
            const area = document.getElementById('uploadWajahArea');
            area.classList.remove('border-primary', 'bg-primary/5');

            const files = e.dataTransfer.files;
            if (files && files.length > 0) {
                const input = document.getElementById('inputFotoWajah');
                input.files = files;
                previewWajah(input);
            }
        }

        function bukaUploadWajah(button) {
            const userId = button.getAttribute('data-id');
            const nama = button.getAttribute('data-nama');

            document.getElementById('wajahSiswaUserId').value = userId;
            document.getElementById('wajahSiswaNama').innerText = nama;

            // Reset input & preview
            document.getElementById('inputFotoWajah').value = '';
            document.getElementById('wajahPlaceholder').classList.remove('hidden');
            document.getElementById('wajahFileInfo').classList.add('hidden');
            document.getElementById('wajahPreview').src = '';
            document.getElementById('btnSimpanWajah').disabled = true;

            const statusContainer = document.getElementById('wajahStatusContainer');
            statusContainer.classList.add('hidden');

            toggleModal('modalUploadWajah');
        }

        function previewWajah(input) {
            const placeholder = document.getElementById('wajahPlaceholder');
            const fileInfo = document.getElementById('wajahFileInfo');
            const preview = document.getElementById('wajahPreview');
            const btnSimpan = document.getElementById('btnSimpanWajah');

            if (input.files && input.files.length > 0) {
                placeholder.classList.add('hidden');
                fileInfo.classList.remove('hidden');

                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                    btnSimpan.disabled = false;
                }
                reader.readAsDataURL(input.files[0]);
            } else {
                placeholder.classList.remove('hidden');
                fileInfo.classList.add('hidden');
                preview.src = '';
                btnSimpan.disabled = true;
            }
        }

        async function prosesEkstraksiWajah() {
            const userId = document.getElementById('wajahSiswaUserId').value;
            const previewImg = document.getElementById('wajahPreview');
            const statusContainer = document.getElementById('wajahStatusContainer');
            const statusText = document.getElementById('wajahStatusText');
            const btnSimpan = document.getElementById('btnSimpanWajah');

            if (!previewImg.src || previewImg.src === '') {
                Swal.fire('Error', 'Silakan pilih foto terlebih dahulu!', 'error');
                return;
            }

            // Disable button and show status
            btnSimpan.disabled = true;
            statusContainer.classList.remove('hidden', 'bg-red-50', 'border-red-100', 'text-red-700', 'bg-green-50', 'border-green-100', 'text-green-700');
            statusContainer.classList.add('bg-slate-50', 'border-slate-100', 'text-slate-700');

            try {
                // Step 1: Load Models
                statusText.innerText = '⏳ Memuat mesin kecerdasan buatan (TensorFlow.js)...';
                if (!blazefaceModel) {
                    blazefaceModel = await blazeface.load();
                }
                if (!tfliteModel) {
                    statusText.innerText = '⏳ Memuat model MobileFaceNet AI...';
                    tfliteModel = await tflite.loadTFLiteModel('/models/mobilefacenet.tflite');
                }

                // Step 2: Face Detection pada gambar asli murni (menghindari distorsi CSS object-cover dan w-40 h-40)
                statusText.innerText = '🔍 Memindai wajah pada gambar...';
                const imgWidth = previewImg.naturalWidth || previewImg.width;
                const imgHeight = previewImg.naturalHeight || previewImg.height;

                const offscreenCanvas = document.createElement('canvas');
                offscreenCanvas.width = imgWidth;
                offscreenCanvas.height = imgHeight;
                const offscreenCtx = offscreenCanvas.getContext('2d');
                offscreenCtx.drawImage(previewImg, 0, 0, imgWidth, imgHeight);

                const predictions = await blazefaceModel.estimateFaces(offscreenCanvas, false);
                if (predictions.length === 0) {
                    throw new Error('Wajah tidak terdeteksi! Pastikan foto menunjukkan wajah dengan jelas dan tidak buram.');
                }

                // Step 3: Crop and Resize langsung menggunakan koordinat asli murni
                statusText.innerText = '✂️ Memotong dan mempersiapkan area wajah...';
                const face = predictions[0];
                const start = face.topLeft;
                const end = face.bottomRight;
                const rawCropX = start[0];
                const rawCropY = start[1];
                const rawCropW = end[0] - start[0];
                const rawCropH = end[1] - start[1];

                // [PERBAIKAN KURSUS BLAZEFACE VS GOOGLE ML KIT]
                // BlazeFace hanya mendeteksi "inner facial core" (alis hingga mulut), sedangkan Google ML Kit di Flutter mendeteksi "full head" (dahi hingga dagu).
                // Perluasan kotak BlazeFace sebesar 35% agar proporsi zoom-nya sama persis dengan potongan Google ML Kit di HP siswa.
                const baseCropW = rawCropW * 1.35;
                const baseCropH = rawCropH * 1.35;
                const baseCropX = rawCropX - (rawCropW * 0.175);
                const baseCropY = rawCropY - (rawCropH * 0.25); // Geser ke atas untuk memasukkan dahi

                // Terapkan Square Crop agar wajah tidak gepeng/terdistorsi saat di-resize ke 112x112
                const maxDimension = Math.max(baseCropW, baseCropH);
                const centerX = baseCropX + baseCropW / 2;
                const centerY = baseCropY + baseCropH / 2;

                let cropX = Math.max(0, centerX - maxDimension / 2);
                let cropY = Math.max(0, centerY - maxDimension / 2);
                let cropW = maxDimension;
                let cropH = maxDimension;

                if (cropX + cropW > imgWidth) {
                    cropW = imgWidth - cropX;
                }
                if (cropY + cropH > imgHeight) {
                    cropH = imgHeight - cropY;
                }
                const finalDimension = Math.min(cropW, cropH);

                const canvas = document.createElement('canvas');
                canvas.width = 112;
                canvas.height = 112;
                const ctx = canvas.getContext('2d');

                ctx.drawImage(offscreenCanvas, cropX, cropY, finalDimension, finalDimension, 0, 0, 112, 112);

                // Step 4: Extract Features / Inference
                statusText.innerText = '🧬 Mengekstraksi biometrik wajah (192-dimensi)...';
                const imgData = ctx.getImageData(0, 0, 112, 112);
                const data = imgData.data;

                const inputArray = [];
                for (let y = 0; y < 112; y++) {
                    const row = [];
                    for (let x = 0; x < 112; x++) {
                        const idx = (y * 112 + x) * 4;
                        const r = (data[idx] - 127.5) / 127.5;
                        const g = (data[idx + 1] - 127.5) / 127.5;
                        const b = (data[idx + 2] - 127.5) / 127.5;
                        row.push([r, g, b]);
                    }
                    inputArray.push(row);
                }

                const inputTensor = tf.tensor4d([inputArray], [1, 112, 112, 3]);
                const outputTensor = tfliteModel.predict(inputTensor);
                const embedding = Array.from(await outputTensor.data());

                // Dispose Tensors
                inputTensor.dispose();
                outputTensor.dispose();

                // Step 5: Save to Backend
                statusText.innerText = '💾 Menyimpan data wajah ke server...';
                const response = await fetch('/daftar-siswa/set-wajah', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userId, faceEmbedding: embedding })
                });

                const result = await response.json();
                if (result.status === 'success') {
                    statusContainer.classList.remove('bg-slate-50', 'border-slate-100', 'text-slate-700');
                    statusContainer.classList.add('bg-green-50', 'border-green-100', 'text-green-700');
                    statusText.innerText = '✅ Wajah berhasil didaftarkan!';

                    // Tutup modal terlebih dahulu
                    toggleModal('modalUploadWajah');

                    Swal.fire({
                        title: 'Berhasil!',
                        text: 'Wajah siswa berhasil didaftarkan.',
                        icon: 'success',
                        confirmButtonColor: '#006D5B'
                    }).then(() => {
                        window.location.reload();
                    });
                } else {
                    throw new Error(result.message || 'Gagal menyimpan data wajah ke server.');
                }

            } catch (err) {
                console.error(err);
                btnSimpan.disabled = false;
                statusContainer.classList.remove('bg-slate-50', 'border-slate-100', 'text-slate-700');
                statusContainer.classList.add('bg-red-50', 'border-red-100', 'text-red-700');
                statusText.innerText = '❌ Error: ' + err.message;

                Swal.fire({
                    title: 'Gagal!',
                    text: err.message,
                    icon: 'error',
                    confirmButtonColor: '#ef4444'
                });
            }
        }
    </script>






</body>

</html>