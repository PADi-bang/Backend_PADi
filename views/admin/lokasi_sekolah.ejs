<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lokasi Sekolah - App_PADi</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="icon" type="image/png" href="/favicon.png">
    
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Leaflet & Leaflet Geoman CDNs -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <link rel="stylesheet" href="https://unpkg.com/@geoman-io/leaflet-geoman-free@2.15.0/dist/leaflet-geoman.css" />
    <script src="https://unpkg.com/@geoman-io/leaflet-geoman-free@2.15.0/dist/leaflet-geoman.min.js"></script>
    <!-- SweetAlert2 CDN -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#006D5B',
                        'primary-dark': '#004A3F',
                        'primary-light': '#338A7B',
                    },
                    fontFamily: {
                        sans: ['Outfit', 'sans-serif'],
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-100 flex font-sans">

    <!-- Mobile Header -->
    <div class="md:hidden bg-[#00382E] text-white p-4 flex justify-between items-center fixed top-0 w-full z-30 shadow-md">
        <div class="flex items-center gap-2">
            <img src="/images/logo_padi.png" alt="Logo" class="w-8 h-8 object-contain drop-shadow-md">
            <span class="text-xl font-black tracking-widest">PADi</span>
        </div>
        <button onclick="document.getElementById('sidebar').classList.remove('-translate-x-full')" class="p-2 bg-white/10 rounded-lg focus:outline-none">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
        </button>
    </div>
    
    <aside id="sidebar" class="w-64 h-screen bg-[#00382E] text-white/70 p-6 flex flex-col fixed rounded-r-3xl shadow-2xl z-40 transform -translate-x-full md:translate-x-0 transition-transform duration-300">
        <div class="flex items-center gap-3 mb-12 mt-4 pl-2">
            <img src="/images/logo_padi.png" alt="Logo" class="w-10 h-10 object-contain drop-shadow-md">
            <span class="text-3xl font-black text-white tracking-widest">PADi</span>
        </div>
        <button onclick="document.getElementById('sidebar').classList.add('-translate-x-full')" class="md:hidden absolute top-6 right-4 p-2 text-white/70 hover:text-white">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
        
        <nav class="flex-1 space-y-3">
            <a href="/dashboard" class="flex items-center gap-4 p-3.5 hover:text-white hover:bg-white/10 rounded-2xl transition">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg> Dashboard
            </a>
            <a href="/daftar-siswa" class="flex items-center gap-4 p-3.5 hover:text-white hover:bg-white/10 rounded-2xl transition">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg> Daftar Siswa
            </a>
            <a href="/daftar-guru" class="flex items-center gap-4 p-3.5 hover:text-white hover:bg-white/10 rounded-2xl transition">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg> Daftar Guru
            </a>
            <a href="/jadwal" class="flex items-center gap-4 p-3.5 hover:text-white hover:bg-white/10 rounded-2xl transition">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg> Jadwal
            </a>
            <a href="/master-data" class="flex items-center gap-4 p-3.5 hover:text-white hover:bg-white/10 rounded-2xl transition">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"></path></svg> Master Data
            </a>
            <a href="/enrolment" class="flex items-center gap-4 p-3.5 hover:text-white hover:bg-white/10 rounded-2xl transition">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222"></path></svg> Enrolment Kelas
            </a>
            <a href="/lokasi-sekolah" class="flex items-center gap-4 p-3.5 bg-primary text-white rounded-2xl shadow-lg shadow-primary/40 transition">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg> Lokasi Sekolah
            </a>
        </nav>
        <div class="mt-auto mb-4">
            <a href="/logout" class="flex justify-center items-center gap-2 bg-primary hover:bg-primary-dark text-white font-bold py-3.5 px-4 rounded-full transition shadow-lg shadow-primary/30">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg> LOGOUT
            </a>
        </div>
    </aside>

    <main class="flex-1 md:ml-64 p-4 md:p-8 pt-24 md:pt-8 w-full transition-all duration-300">
        <!-- Top Banner -->
        <div class="bg-primary rounded-3xl p-4 flex justify-between items-center text-white mb-8 shadow-lg shadow-primary/20">
            <h1 class="text-2xl font-bold ml-4">Pengaturan Lokasi Sekolah</h1>
            <div class="flex items-center gap-6 pr-4">
                <div class="flex items-center gap-3 border-l border-primary-light/50 pl-6 cursor-pointer">
                    <span class="text-sm font-bold tracking-wide uppercase"><%= locals.adminName || 'Admin' %></span>
                    <div class="w-9 h-9 bg-white rounded-full flex items-center justify-center text-primary font-bold text-xs">AD</div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <!-- Form Details -->
            <div class="lg:col-span-1 bg-white p-8 rounded-3xl shadow-sm border border-gray-100 flex flex-col justify-between">
                <form action="/lokasi-sekolah" method="POST" id="locationForm" class="space-y-6">
                    <div>
                        <h2 class="text-xl font-bold text-gray-800 mb-2">Detail Sekolah</h2>
                        <p class="text-sm text-gray-500">Sesuaikan informasi instansi dan batas wilayah sekolah untuk sistem presensi.</p>
                    </div>



                    <div class="space-y-2">
                        <span class="text-sm font-semibold text-gray-700 block">Status Geofencing</span>
                        <div class="space-y-2.5">
                            <label class="flex items-center gap-3 p-3.5 rounded-2xl border border-gray-200 cursor-pointer hover:bg-slate-50 transition">
                                <input type="radio" name="isGeofenceActive" value="true" class="w-4 h-4 text-primary focus:ring-primary accent-primary" <%= sekolah.isGeofenceActive ? 'checked' : '' %>>
                                <div>
                                    <span class="text-sm font-semibold text-gray-800 block">🟢 Aktif</span>
                                    <span class="text-xs text-gray-500">Presensi wajib di dalam area sekolah.</span>
                                </div>
                            </label>
                            <label class="flex items-center gap-3 p-3.5 rounded-2xl border border-gray-200 cursor-pointer hover:bg-slate-50 transition">
                                <input type="radio" name="isGeofenceActive" value="false" class="w-4 h-4 text-primary focus:ring-primary accent-primary" <%= !sekolah.isGeofenceActive ? 'checked' : '' %>>
                                <div>
                                    <span class="text-sm font-semibold text-gray-800 block">🔴 Nonaktif</span>
                                    <span class="text-xs text-gray-500">Siswa bebas presensi dari mana saja.</span>
                                </div>
                            </label>
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label for="namaSekolah" class="text-sm font-semibold text-gray-700">Nama Sekolah</label>
                        <input type="text" id="namaSekolah" name="namaSekolah" value="<%= sekolah.nama_sekolah %>" required
                               class="w-full px-4 py-3 rounded-2xl border border-gray-200 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition text-sm">
                    </div>

                    <div class="space-y-2">
                        <label for="alamat" class="text-sm font-semibold text-gray-700">Alamat Sekolah</label>
                        <textarea id="alamat" name="alamat" rows="3" required
                                  class="w-full px-4 py-3 rounded-2xl border border-gray-200 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition text-sm resize-none"><%= sekolah.alamat %></textarea>
                    </div>

                    <!-- Hidden input to store polygon coordinates -->
                    <input type="hidden" id="coordinates" name="coordinates" value="">
                    <input type="hidden" id="isMapEdited" name="isMapEdited" value="false">

                    <div class="space-y-2 bg-slate-50 p-4 rounded-2xl border border-dashed border-gray-200">
                        <span class="text-xs font-semibold uppercase tracking-wider text-gray-400">Info Geofence</span>
                        <div class="flex items-center justify-between text-sm mt-1">
                            <span class="text-gray-500">Status Batasan:</span>
                            <span id="geofenceStatus" class="font-bold text-red-500">Belum Digambar</span>
                        </div>
                        <div class="flex items-center justify-between text-sm mt-1">
                            <span class="text-gray-500">Jumlah Titik:</span>
                            <span id="geofencePoints" class="font-bold text-gray-700">0</span>
                        </div>
                    </div>

                    <button type="submit" class="w-full bg-primary hover:bg-primary-dark text-white font-bold py-4 rounded-full transition shadow-lg shadow-primary/30 flex items-center justify-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"></path></svg> Simpan Perubahan
                    </button>
                </form>
            </div>

            <!-- Map View -->
            <div class="lg:col-span-2 bg-white p-6 rounded-3xl shadow-sm border border-gray-100 flex flex-col">
                <div class="flex justify-between items-center mb-4">
                    <div>
                        <h2 class="text-xl font-bold text-gray-800">Petakan Wilayah Sekolah</h2>
                        <p class="text-sm text-gray-500">Gunakan alat gambar poligon di sisi kiri peta untuk menentukan geofence.</p>
                    </div>
                    <span class="bg-primary/10 text-primary text-xs font-semibold px-3 py-1.5 rounded-full flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                        Mode Geofencing
                    </span>
                </div>
                
                <div id="map" class="w-full h-[500px] rounded-2xl border border-gray-100 z-10 shadow-inner"></div>
                
                <div class="mt-4 flex flex-col md:flex-row gap-4 justify-between items-start md:items-center text-xs text-gray-400">
                    <div class="flex items-center gap-4">
                        <span class="flex items-center gap-1"><span class="w-3 h-3 bg-primary/20 border border-primary rounded"></span> Area Sekolah</span>
                        <span class="flex items-center gap-1">📍 Klik icon poligon di kiri atas peta untuk mulai menggambar</span>
                    </div>
                    <button type="button" id="btnResetMap" class="text-primary hover:text-primary-dark font-semibold transition">
                        Reset Tampilan Peta
                    </button>
                </div>
            </div>
        </div>
    </main>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            let currentPointsCount = 0;
            // Default coordinates: Semarang (-7.053, 110.435)
            let defaultLat = -7.053;
            let defaultLng = 110.435;

            // Data GeoJSON dari Backend
            const existingGeoJSON = <%- sekolah.polygon_geojson ? sekolah.polygon_geojson : 'null' %>;
            let geofenceLayer = null;

            // Jika ada koordinat awal, gunakan titik pertamanya sebagai titik tengah peta
            if (existingGeoJSON && existingGeoJSON.coordinates && existingGeoJSON.coordinates.length > 0 && existingGeoJSON.coordinates[0].length > 0) {
                const firstCoord = existingGeoJSON.coordinates[0][0];
                defaultLng = firstCoord[0];
                defaultLat = firstCoord[1];
            }

            // 1. Inisialisasi Peta
            const map = L.map('map').setView([defaultLat, defaultLng], 17);

            // 2. Tambah Layer Google Maps (Roadmap & Satelit Hybrid)
            const googleRoadmap = L.tileLayer('https://mt1.google.com/vt/lyrs=m&x={x}&y={y}&z={z}', {
                maxZoom: 20,
                attribution: '© Google Maps'
            });

            const googleSatellite = L.tileLayer('https://mt1.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
                maxZoom: 20,
                attribution: '© Google Maps'
            });

            // Tampilkan Google Roadmap secara default
            googleRoadmap.addTo(map);

            // Tambahkan Control Layer di kanan atas untuk ganti jenis peta
            const baseMaps = {
                "Google Maps (Default)": googleRoadmap,
                "Google Satellite": googleSatellite
            };
            L.control.layers(baseMaps, null, { position: 'topright' }).addTo(map);

            // 3. Render Area Sekolah jika sudah ada
            if (existingGeoJSON && existingGeoJSON.coordinates && existingGeoJSON.coordinates.length > 0) {
                const rawCoords = existingGeoJSON.coordinates[0];
                // GeoJSON: [longitude, latitude] -> Leaflet: [latitude, longitude]
                const leafletCoords = rawCoords.map(coord => [coord[1], coord[0]]);
                
                geofenceLayer = L.polygon(leafletCoords, {
                    color: '#006D5B',
                    fillColor: '#006D5B',
                    fillOpacity: 0.2,
                    weight: 3
                }).addTo(map);

                // Zoom map ke area sekolah
                map.fitBounds(geofenceLayer.getBounds());
                
                // Simpan koordinat ke input tersembunyi
                document.getElementById('coordinates').value = JSON.stringify(rawCoords);
                updateGeofenceStats(rawCoords.length);
            } else {
                updateGeofenceStats(0);
            }

            // 4. Inisialisasi Geoman (Gambar & Edit)
            map.pm.addControls({
                position: 'topleft',
                drawMarker: false,
                drawCircleMarker: false,
                drawPolyline: false,
                drawRectangle: false,
                drawCircle: false,
                drawPolygon: true,
                editMode: true,
                dragMode: true,
                cutPolygon: false,
                removalMode: true
            });

            // Set tema Geoman agar serasi dengan primary color
            map.pm.setPathOptions({
                color: '#006D5B',
                fillColor: '#006D5B',
                fillOpacity: 0.2
            });

            // Saat poligon selesai digambar
            map.on('pm:create', function(e) {
                document.getElementById('isMapEdited').value = 'true';
                // Hapus poligon lama jika ada (hanya boleh ada 1 area geofence)
                if (geofenceLayer) {
                    map.removeLayer(geofenceLayer);
                }
                
                geofenceLayer = e.layer;
                
                // Daftarkan listener edit pada layer baru ini
                geofenceLayer.on('pm:edit', handleLayerChange);
                
                handleLayerChange();
            });

            // Saat layer diubah (di-edit/di-drag)
            function handleLayerChange() {
                document.getElementById('isMapEdited').value = 'true';
                if (geofenceLayer) {
                    const latLngs = geofenceLayer.getLatLngs()[0];
                    
                    // Konversi kembali ke format GeoJSON [lng, lat]
                    const coords = latLngs.map(ll => [ll.lng, ll.lat]);
                    
                    // Tambahkan titik pertama ke akhir untuk menutup poligon
                    coords.push([latLngs[0].lng, latLngs[0].lat]);
                    
                    document.getElementById('coordinates').value = JSON.stringify(coords);
                    updateGeofenceStats(coords.length);
                }
            }

            // Saat layer dihapus
            map.on('pm:remove', function(e) {
                if (e.layer === geofenceLayer) {
                    document.getElementById('isMapEdited').value = 'true';
                    geofenceLayer = null;
                    document.getElementById('coordinates').value = '';
                    updateGeofenceStats(0);
                }
            });

            // Helper to get selected radio button value
            function getGeofenceActiveState() {
                const radios = document.getElementsByName('isGeofenceActive');
                for (const radio of radios) {
                    if (radio.checked) {
                        return radio.value === 'true';
                    }
                }
                return true;
            }

            // Fungsi memperbarui status dan jumlah titik koordinat
            function updateGeofenceStats(pointsCount) {
                if (typeof pointsCount === 'number') {
                    currentPointsCount = pointsCount;
                }

                // Membaca status aktif yang tersimpan di database saat ini
                const isGeofenceActive = <%= sekolah.isGeofenceActive ? 'true' : 'false' %>;
                const statusEl = document.getElementById('geofenceStatus');
                const pointsEl = document.getElementById('geofencePoints');
                
                pointsEl.textContent = currentPointsCount;

                if (!isGeofenceActive) {
                    statusEl.textContent = "Nonaktif (Di-bypass)";
                    statusEl.className = "font-bold text-slate-500 bg-slate-100 px-3 py-1 rounded-full text-xs transition";
                } else if (currentPointsCount > 0) {
                    statusEl.textContent = "Aktif (Terpetakan)";
                    statusEl.className = "font-bold text-green-700 bg-green-50 px-3 py-1 rounded-full text-xs transition";
                } else {
                    statusEl.textContent = "Belum Digambar";
                    statusEl.className = "font-bold text-amber-600 bg-amber-50 px-3 py-1 rounded-full text-xs transition";
                }
            }

            // Tombol Reset Tampilan Peta
            document.getElementById('btnResetMap').addEventListener('click', function() {
                if (geofenceLayer) {
                    map.fitBounds(geofenceLayer.getBounds());
                } else {
                    map.setView([defaultLat, defaultLng], 17);
                }
            });

            // SweetAlert2 Toast/Pop Up Notifikasi dari Server
            const serverSuccess = "<%= typeof success !== 'undefined' && success ? success : '' %>";
            const serverError = "<%= typeof error !== 'undefined' && error ? error : '' %>";

            if (serverSuccess && serverSuccess !== 'null' && serverSuccess.trim() !== '') {
                Swal.fire({
                    icon: 'success',
                    title: 'Berhasil!',
                    text: serverSuccess,
                    confirmButtonColor: '#006D5B',
                    customClass: {
                        popup: 'rounded-3xl',
                        confirmButton: 'rounded-full px-6 py-2.5 font-semibold text-sm'
                    }
                });
                // Bersihkan URL query parameter agar tidak muncul lagi saat di-refresh
                window.history.replaceState({}, document.title, window.location.pathname);
            }

            if (serverError && serverError !== 'null' && serverError.trim() !== '') {
                Swal.fire({
                    icon: 'error',
                    title: 'Gagal!',
                    text: serverError,
                    confirmButtonColor: '#006D5B',
                    customClass: {
                        popup: 'rounded-3xl',
                        confirmButton: 'rounded-full px-6 py-2.5 font-semibold text-sm'
                    }
                });
                // Bersihkan URL query parameter agar tidak muncul lagi saat di-refresh
                window.history.replaceState({}, document.title, window.location.pathname);
            }

            // Validasi Form sebelum kirim
            document.getElementById('locationForm').addEventListener('submit', function(e) {
                const isGeofenceActive = getGeofenceActiveState();
                const coordsVal = document.getElementById('coordinates').value;
                if (isGeofenceActive && (!coordsVal || coordsVal.trim() === '')) {
                    e.preventDefault();
                    Swal.fire({
                        icon: 'warning',
                        title: 'Area Belum Digambar',
                        text: 'Silakan gambar area sekolah Anda pada peta terlebih dahulu apabila status geofencing aktif!',
                        confirmButtonColor: '#006D5B',
                        customClass: {
                            popup: 'rounded-3xl',
                            confirmButton: 'rounded-full px-6 py-2.5 font-semibold text-sm'
                        }
                    });
                }
            });

            });
    </script>
</body>
</html>
